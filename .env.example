# MongoDB Local (Docker Compose)
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=vi_db
MONGO_HOST_PORT=27018

# JWT Authentication
JWT_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_SEGURO_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# Seed Operator Account (US-01)
DEFAULT_USERNAME=vi
DEFAULT_EMAIL=usuario@ejemplo.com
DEFAULT_PASSWORD=CambiarContrasenaSegura2026*
