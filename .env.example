# Base de datos MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=vi_vigilancia_inteligente

# Seguridad JWT (sesion unica no recurrente)
JWT_SECRET_KEY=cambiar_por_clave_secreta_segura
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Recuperacion de contrasena por correo (RF-02)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=correo@ejemplo.com
SMTP_PASSWORD=contrasena_de_aplicacion

# Configuracion del motor de vision artificial (CPU/RAM)
YOLO_MODEL_PATH=/app/models/yolo11n.pt
OMP_NUM_THREADS=2
MAX_MP4_SIZE_MB=50

# Umbrales por defecto de merodeo
DEFAULT_DWELL_TIME_SEC=15.0
DEFAULT_RECURRENCE_LEVEL=media

# Servidor web
PORT=8000
