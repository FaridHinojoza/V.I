# SMTP Password Recovery (empty SMTP_HOST -> logs recovery code in dev/test)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=correo@ejemplo.com
SMTP_PASSWORD=contrasena_de_aplicacion
